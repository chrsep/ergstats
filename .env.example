# Concept2 Logbook API app credentials, from https://log.concept2.com/developers/keys
# Register the redirect URL as <PUBLIC_URL>/callback
CONCEPT2_CLIENT_ID=
CONCEPT2_CLIENT_SECRET=

# Use https://log-dev.concept2.com while testing against the dev server
CONCEPT2_BASE_URL=https://log.concept2.com

# Secret used to encrypt every token this server issues. Generate one with:
#   openssl rand -base64 32
# Rotating it signs every user out.
TOKEN_SECRET=

# Public origin of the deployment, e.g. https://ergdata.example.com
# Optional on Vercel: falls back to the request's forwarded host.
PUBLIC_URL=
