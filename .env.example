# Neon Postgres. The Neon integration on Vercel sets this for you.
DATABASE_URL=

# BetterAuth. Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL of the app, no trailing slash.
BETTER_AUTH_URL=http://localhost:3000

# Concept2 Logbook API app, from https://log.concept2.com/developers/keys
# Redirect URI to register: <BETTER_AUTH_URL>/api/auth/callback/concept2
CONCEPT2_CLIENT_ID=
CONCEPT2_CLIENT_SECRET=
# Use https://log-dev.concept2.com while testing against Concept2's dev server.
CONCEPT2_BASE_URL=https://log.concept2.com

# PostHog analytics, error tracking, traces and logs. Leave empty to send nothing.
NEXT_PUBLIC_POSTHOG_TOKEN=
# "us" if the PostHog project is in US Cloud. EU Cloud otherwise.
NEXT_PUBLIC_POSTHOG_REGION=
